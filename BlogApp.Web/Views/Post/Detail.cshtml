@model GetByUrlPostDetailViewModel

@{
    ViewData["Title"] = "PostDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card bg-white shadow-sm border-0 mb-5">
                <div class="card-body">
                    <h1 class="h3 mb-3">@Model.Title</h1>
                    <p class="text-muted">Kategori: <strong>@Model.CategoryName</strong></p>
                    <p class="text-muted mb-4">Yayınlanma Tarihi: <strong>@Model.PublishedDate.ToString("dd MMMM yyyy")</strong></p>

                    @if (Model.Image != null)
                    {
                        <div class="mb-4 text-center">
                            <img src="@Url.Content("~/images/" + Model.Image)" alt="@Model.Title" class="img-fluid rounded shadow-sm" style="max-width: 100%; height: auto;">
                        </div>
                    }

                    <div class="content mb-4">
                        <h3 class="h5 mb-3">Açıklama</h3>
                        <p>@Model.Description</p>
                    </div>

                    <div class="content mb-4">
                        <h3 class="h5 mb-3">İçerik</h3>
                        <p>@Model.Content</p>
                    </div>

                    <h4><span id="commentCount">@Model.Comments.Count() adet yorum var.</span></h4>
                    <div id="comments">
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="card mb-3 shadow-sm border-0">
                                <div class="card-header d-flex align-items-center">
                                    <img src="@Url.Content("/images/" + comment.AppUser.ImageUrl)" alt="@comment.AppUser.UserName" class="img-fluid rounded-circle" style="width: 50px; height: 50px;">
                                    <h5 class="ms-3 mb-0">@comment.AppUser.UserName</h5>
                                </div>
                                <div class="card-body">
                                    <p>@comment.Text</p>
                                    <p class="text-muted">Yayınlanma Tarihi: @comment.PublishedDate</p>
                                </div>
                            </div>
                        }
                    </div>

                    @if (User.Identity!.IsAuthenticated)
                    {
                        <hr class="my-4">
                        <div>
                            <h4 class="mb-3">Yorum Ekle</h4>
                            <form action="/Post/AddComment" method="post">
                                <input type="hidden" id="PostId" name="PostId" value="@Model.PostId">
                                <div class="mb-3">
                                    <label for="Text" class="form-label">Yorum</label>
                                    <textarea type="text" name="Text" id="Text" class="form-control" rows="3" placeholder="Yorumunuzu buraya yazın..."></textarea>
                                </div>
                                <div class="mb-3 text-end">
                                    <button type="submit" id="btnYorumKayit" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-arrow-right-circle"></i> Kaydet
                                    </button>
                                </div>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mt-3" role="alert">
                            <p class="mb-0">Yorum yapabilmek için lütfen <a href="/User/SignIn" class="text-decoration-none">giriş yapın</a>.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            $("#btnYorumKayit").click(function () {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("AddComment")',
                    dataType: 'json',
                    data: {
                        PostId: $('#PostId').val(),
                        Text: $('#Text').val()
                    },
                    success: function (yorum) {

                        const tarih = new Date(yorum.publishedDate);
                        const options = {
                             day: '2-digit',
                             month: 'long',
                             year: 'numeric',
                             hour: '2-digit',
                             minute: '2-digit',
                             second: '2-digit'
                        };
                        const yayimTarihi = tarih.toLocaleDateString('tr-TR', options);

                        $("#comments").append(`
                            <div class="card mb-3 shadow-sm border-0">
                                <div class="card-header d-flex align-items-center">
                                    <img src="/images/${yorum.avatar}" class="img-fluid rounded-circle" style="width: 50px; height: 50px;">
                                    <h5 class="ms-3 mb-0">${yorum.username}</h5>
                                </div>
                            </div>
                            <div class="card-body">
                            <p>${yorum.text}</p>
                            <p class="text-muted">Yayınlanma Tarihi: ${yayimTarihi}</p>
                            </div>
                            </div>
                            `);

                            $("#UserName").val('');
                            $("#Text").val('');

                            var adet = parseInt($("#commentCount").text());
                            $("#commentCount").text(adet + 1) + " adet yorum var.";
                    }
                });
                return false;
            })
        });
    </script>
}
