@model List<ResultPostViewModel>

@{
    ViewData["Title"] = "List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int count = 0;
}

<div class="content py-4">
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-12">
                <h4 class="page-title text-center font-weight-bold text-dark p-3 rounded shadow-sm bg-white">
                    Blog Yazılarınız
                </h4>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body">
                        <div class="table-responsive rounded-3">
                            <table class="table table-hover table-striped table-bordered align-middle mb-0 rounded-3 overflow-hidden">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">#</th>
                                        <th scope="col">Görsel</th>
                                        <th scope="col">Başlık</th>
                                        <th scope="col">Kategori</th>
                                        <th scope="col">Açıklama</th>
                                        <th scope="col">İçerik</th>
                                        <th scope="col">Durum</th>
                                        <th scope="col">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        count++;
                                        <tr>
                                            <td>@count</td>
                                            <td>
                                                <img src="~/images/@item.Image"
                                                     style="width: 150px; height: 100px; object-fit: cover; border-radius: 0.5rem;"
                                                     alt="Blog Image" class="img-fluid shadow-sm">
                                            </td>
                                            <td><strong>@item.Title</strong></td>
                                            <td>@item.CategoryName</td>
                                            <td>@(item.Description!.Length > 100 ? item.Description.Substring(0, item.Description.IndexOf(" ", 100)) + "..." : item.Description)</td>
                                            <td>@(item.Content!.Length > 100 ? item.Content.Substring(0, item.Content.IndexOf(" ", 100)) + "..." : item.Content)</td>
                                            <td class="text-center">
                                                @if (item.IsActive)
                                                {
                                                    <span class="badge bg-success">Aktif</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Pasif</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex flex-wrap gap-1">
                                                    <a href="/Post/Delete/@item.PostId" class="btn btn-outline-danger btn-sm"
                                                       title="Sil">
                                                        <i class="bi bi-trash"></i> <span class="d-none d-md-inline">Sil</span>
                                                    </a>
                                                    <a href="/Post/Update/@item.PostId" class="btn btn-outline-success btn-sm"
                                                       title="Güncelle">
                                                        <i class="bi bi-pencil-square"></i> <span class="d-none d-md-inline">Güncelle</span>
                                                    </a>
                                                    <a href="/Post/ChangeStatus/@item.PostId" class="btn btn-outline-warning btn-sm"
                                                       title="Durum Değiştir">
                                                        @if (item.IsActive)
                                                        {
                                                            <i class="bi bi-toggle-on"></i> <span class="d-none d-md-inline">Durum</span>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-toggle-off"></i> <span class="d-none d-md-inline">Durum</span>
                                                        }
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-end">
                            <a href="/Post/Create/" class="btn btn-outline-primary mt-3">
                                <i class="bi bi-plus-circle"></i> Yeni Post Ekle
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
