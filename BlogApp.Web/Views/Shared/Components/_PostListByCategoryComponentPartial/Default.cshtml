@model List<ResultPostViewModel>

<div class="content py-4">
    <div class="container-fluid">
        <div class="row mb-4">
            <div class="col-12">
                <h4 class="page-title text-center font-weight-bold text-dark p-3 rounded shadow-sm bg-white">
                    @Model.FirstOrDefault()?.CategoryName Kategorisindeki Blog Yazıları
                </h4>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-10 col-lg-10">
                @foreach (var item in Model)
                {
                    <div class="card bg-white border-0 mb-4 shadow-sm p-3 rounded">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-4">
                                <a href="/Post/Detail/@item.Url">
                                    <img src="~/images/@(item.Image ?? "not-available.png")"
                                         class="img-fluid rounded shadow-sm"
                                         alt="@item.Title">
                                </a>
                            </div>
                            <div class="col-md-8 d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="mb-2">
                                        <a href="/Post/Detail/@item.Url"
                                           class="fw-bold text-dark text-decoration-none hover-underline-animation">
                                            @item.Title
                                        </a>
                                    </h5>
                                    <p class="text-muted mb-2">@item.Description</p>
                                </div>

                                <div class="mt-3 text-end">
                                    <a href="/Post/Detail/@item.Url" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-arrow-right-circle"></i> Detaya Git
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

