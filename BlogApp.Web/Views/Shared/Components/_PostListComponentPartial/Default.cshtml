@model List<ResultPostViewModel>

<div class="bg-white p-4">
    <h1 class="h4 mb-4">Mevcut Blog Yazıları</h1>

    @foreach (var item in Model)
    {
        <div class="card bg-transparent border-0 mb-3">
            <div class="row g-3 align-items-center">

                <div class="col-md-4">
                    <img src="~/images/@(item.Image ?? "not-available.png")"
                         class="img-fluid rounded shadow-sm" style="object-fit: cover; width: 100%; height: 150px;" alt="Blog Görseli">
                </div>

                <div class="col-md-8">
                    <h5 class="mb-2 d-flex justify-content-between">
                            @item.Title

                        <a href="/Post/Detail/@item.Url" class="btn btn-outline-success btn-sm">
                            <i class="bi bi-arrow-right-circle"></i> Detaya Git
                        </a>
                    </h5>

                    <p class="text-muted mb-2" style="font-size: 14px;">
                        @(item.Description?.Length > 100 ? item.Description.Substring(0, item.Description.IndexOf(" ", 100)) + "..." : item.Description)
                    </p>

                    <span class="badge bg-info text-white p-2" style="font-size: 13px;">
                        @item.CategoryName
                    </span>
                </div>
            </div>
        </div>
        <hr class="my-3" />
    }
</div>
