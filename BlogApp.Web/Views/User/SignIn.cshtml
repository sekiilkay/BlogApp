@model SignInViewModel

@{
    ViewData["Title"] = "SignIn";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-body p-4">
                    <h4 class="card-title text-center mb-4 text-primary">BlogApp'e Tekrar Hoş Geldiniz!</h4>
                    <p class="text-center mb-4 text-muted">Giriş yapmak için aşağıdaki bilgileri doldurun.</p>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert">
                    </div>

                    <form method="post">
                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" id="email" placeholder="E-posta adresinizi giriniz" name="Email" asp-for="Email" required>
                            <label for="email">E-posta Adresiniz</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="password" class="form-control" id="password" placeholder="Şifrenizi oluşturun" name="Password" asp-for="Password" required>
                            <label for="password">Şifre</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">Giriş Yap</button>
                    </form>

                    <div class="mt-3 text-center">
                        <small class="text-muted">Hesabınız yok mu? <a href="/User/Register" class="text-primary text-decoration-none">Kayıt Olun</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<br />
